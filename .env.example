# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: extra keys from OTHER Google projects (comma-separated). Each project has its own
# quota; on a 429 the service retries the same model on the next key before falling back.
GEMINI_API_KEYS=

LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest
# -1 = don't send a thinking config (some models reject thinking_budget=0)
LLM_THINKING_BUDGET=-1
LLM_TIMEOUT_S=9
LLM_FALLBACK_TIMEOUT_S=8
LLM_MAX_REPAIRS=1

REQUEST_DEADLINE_S=25
INTERPRETATION_CACHE_SIZE=2048
ENABLE_HEDGING=true
ENABLE_SECONDARY_OBJECTIVE=true
ENABLE_RULE_FALLBACK=true
INFEASIBLE_POLICY=best_effort
PROMPT_VERSION=v1

LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2
